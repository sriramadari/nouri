# Server
PORT=3000

# Neon Postgres. `neon env pull` writes DATABASE_URL and DATABASE_URL_UNPOOLED;
# copy the unpooled value into DIRECT_URL. Use sslmode=verify-full (full certificate check).
# Pooled connection (hostname contains -pooler), used by the running app.
DATABASE_URL=postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=verify-full
# Direct (unpooled) connection, used only by Prisma migrations.
DIRECT_URL=postgresql://user:password@ep-example.region.aws.neon.tech/neondb?sslmode=verify-full

# AI provider: "gemini" (default) or "mock" for offline development and tests
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
